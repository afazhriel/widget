  /* ============================================================
     HLS.JS
     ============================================================ */

  async function ensureHls() {

    if (window.Hls) {
      return window.Hls;
    }


    const existing =
      document.querySelector(
        'script[data-iotizen-hls="true"]'
      );


    if (existing) {

      return new Promise(
        (
          resolve,
          reject
        ) => {

          if (window.Hls) {

            resolve(
              window.Hls
            );

            return;

          }


          existing.addEventListener(
            "load",
            () =>
              resolve(
                window.Hls
              ),
            {
              once:true
            }
          );


          existing.addEventListener(
            "error",
            () =>
              reject(
                new Error(
                  "HLS.js gagal dimuat"
                )
              ),
            {
              once:true
            }
          );

        }
      );

    }


    return new Promise(
      (
        resolve,
        reject
      ) => {

        const script =
          document.createElement(
            "script"
          );


        script.src =
          HLS_JS_URL;


        script.dataset.iotizenHls =
          "true";


        script.onload =
          () => {

            if (window.Hls) {

              resolve(
                window.Hls
              );

            }

            else {

              reject(
                new Error(
                  "HLS.js tidak tersedia"
                )
              );

            }

          };


        script.onerror =
          () =>
            reject(
              new Error(
                "HLS.js gagal dimuat"
              )
            );


        document.head.appendChild(
          script
        );

      }
    );

  }


