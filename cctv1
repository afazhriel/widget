     ============================================================ */

  function getPlaybackQuery() {

    const date =
      playbackDate.value;

    const start =
      playbackStart.value;

    const end =
      playbackEnd.value;


    if (!date) {

      throw new Error(
        "Pilih tanggal"
      );

    }


    if (
      !start ||
      !end
    ) {

      throw new Error(
        "Pilih jam mulai dan selesai"
      );

    }


    if (
      date <
        minimumPlaybackDate ||
      date >
        todayPlaybackDate
    ) {

      throw new Error(
        "Tanggal hanya tersedia untuk 7 hari terakhir"
      );

    }


    if (
      end <= start
    ) {

      throw new Error(
        "Jam selesai harus setelah jam mulai"
      );

    }


    const durationSeconds =
      parsePlaybackDuration();


    if (
      !Number.isFinite(
        durationSeconds
      ) ||
      durationSeconds <= 0
    ) {

      throw new Error(
        "Durasi playback tidak valid"
      );

    }


    if (
      durationSeconds >
      3600
    ) {

      throw new Error(
        "Rentang maksimum 1 jam"
      );

    }


    return (
      `camera=${encodeURIComponent(cameraNumber)}` +
      `&date=${encodeURIComponent(date)}` +
      `&start=${encodeURIComponent(start)}` +
      `&end=${encodeURIComponent(end)}`
    );

  }


  /* ============================================================
     PARSE HLS PLAYLIST
     ============================================================ */

  function parseHlsPlaylist(text) {

    const extinfMatches =
      text.match(
        /^#EXTINF:([0-9.]+)/gm
      ) || [];


    let totalDuration = 0;


    for (
      const line of extinfMatches
    ) {

      const match =
        line.match(
          /^#EXTINF:([0-9.]+)/
        );


      if (match) {

        totalDuration +=
          Number(match[1]) || 0;

      }

    }


    return {
      segmentCount:
        extinfMatches.length,

      totalDuration,

      ended:
        text.includes(
          "#EXT-X-ENDLIST"
        )
    };

  }


  /* ============================================================
     WAIT FULL HLS VOD PLAYLIST
     ============================================================ */

  async function waitPlaylistReady(
    playlistUrl,
    expectedDuration
  ) {

    const expected =
      Math.max(
        1,
        Number(
          expectedDuration
        ) || 0
      );


    playbackStatus.textContent =
      `Menunggu recording ${formatDuration(expected)}...`;


    for (
      let attempt = 1;
      attempt <= 180;
      attempt++
    ) {

      try {

        const separator =
          playlistUrl.includes("?")
            ? "&"
            : "?";


        const response =
          await fetch(
            `${playlistUrl}${separator}_=${Date.now()}`,
            {
              method:
                "GET",

              /*
               * PLAYLIST PUBLIC HLS:
               * Jangan kirim browser credentials/cookie.
               * Authorization token hanya diperlukan
               * untuk endpoint API seperti /start dan /stop.
               */
              credentials:
                "omit",

              cache:
                "no-store"
            }
          );


        if (response.ok) {

          const text =
            await response.text();


          const info =
            parseHlsPlaylist(
              text
            );


          const enoughDuration =
            info.totalDuration >=
            (
              expected - 0.5
            );


          const finished =
            info.ended;


          if (
            enoughDuration &&
            finished
          ) {

            console.log(
              "[PLAYBACK HLS READY]",
              {
                expected,
                actual:
                  info.totalDuration,
                segments:
                  info.segmentCount,
                ended:
                  info.ended
              }
            );


            playbackStatus.textContent =
              `Playlist siap · ${formatDuration(info.totalDuration)}`;


            return {
              duration:
                info.totalDuration,

              segmentCount:
                info.segmentCount,

              ended:
                info.ended
            };

          }


          playbackStatus.textContent =
            `Menyiapkan HLS ${formatDuration(info.totalDuration)} / ${formatDuration(expected)}`;

        }

      }

      catch (error) {

        console.warn(
          "[WAIT HLS]",
          error
        );

      }


      await sleep(
        500
      );

    }


    throw new Error(
      "Playlist HLS tidak selesai sesuai durasi request"
    );

  }


