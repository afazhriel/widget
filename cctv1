      "[Playback] LEVEL_LOADED:",
      {
        totalduration: details.totalduration,
        live: details.live,
        fragments: details.fragments?.length
      }
    );

    // HANYA update status.
    // Tidak menunggu ENDLIST.
    if (details.fragments?.length) {
      playbackStatus.textContent =
        "Recording diputar";
    }
  });

  playbackHls.on(Hls.Events.ERROR, (_event, data) => {
    console.log(
  "[DIAG HLS ERROR]",
  {
    type: data?.type,
    details: data?.details,
    fatal: data?.fatal,
    error: data?.error,
    reason: data?.reason,
    url: data?.url
  }
);
    console.warn(
      "[Playback] HLS error:",
      data
    );

    if (!data?.fatal) {
      return;
    }

    switch (data.type) {
      case Hls.ErrorTypes.NETWORK_ERROR:
        console.warn(
          "[Playback] Fatal network error, mencoba recovery..."
        );

        try {
          playbackHls.startLoad();
        } catch (error) {
          console.error(
            "[Playback] startLoad gagal:",
            error
          );
        }

        break;

      case Hls.ErrorTypes.MEDIA_ERROR:
        console.warn(
          "[Playback] Fatal media error, mencoba recovery..."
        );

        try {
          playbackHls.recoverMediaError();
        } catch (error) {
          console.error(
            "[Playback] recoverMediaError gagal:",
            error
          );
        }

        break;

      default:
        console.error(
          "[Playback] Fatal HLS error:",
          data
        );

        try {
          playbackHls.destroy();
        } catch (_) {}

        playbackHls = null;

        playbackStatus.textContent =
          "Gagal memutar recording";
        break;
    }
  });

  // =========================================================
  // LANGSUNG LOAD PLAYLIST
  // =========================================================
  console.log(
    "[Playback] Loading HLS playlist:",
    absolutePlaylistUrl
  );

  playbackHls.loadSource(absolutePlaylistUrl);
  playbackHls.attachMedia(playbackVideo);
}

