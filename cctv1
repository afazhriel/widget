  /* ============================================================
     DOWNLOAD MP4
     ============================================================ */

  async function downloadRecording() {

    downloadButton.disabled =
      true;


    try {

      if (!currentPlaybackPublicUrl) {

        throw new Error(
          "playback_public_url belum tersedia"
        );

      }


      const query =
        getPlaybackQuery();


      const requestedDuration =
        parsePlaybackDuration();


      playbackStatus.textContent =
        "Melepas playback...";


      await stopPlayback(
        true
      );


      await sleep(
        1000
      );


      const downloadUrl =
        `${currentPlaybackPublicUrl}` +
        `/api/playback/download?` +
        `${query}` +
        `&_=${Date.now()}`;


      let response =
        null;


      for (
        let attempt = 1;
        attempt <= 10;
        attempt++
      ) {

        playbackStatus.textContent =
          attempt === 1
            ? `Menyiapkan MP4 ${formatDuration(requestedDuration)}...`
            : `Menunggu NVR ${attempt}/10...`;


        response =
          await fetch(
            downloadUrl,
            {
              method:
                "GET",

              headers:
                authHeaders(),

              cache:
                "no-store"
            }
          );


        if (response.ok) {
          break;
        }


        if (
          response.status === 409 &&
          attempt < 10
        ) {

          await sleep(
            800
          );


          continue;

        }


        throw new Error(
          await responseError(
            response
          )
        );

      }


      if (
        !response ||
        !response.ok
      ) {

        throw new Error(
          "Download gagal"
        );

      }


      playbackStatus.textContent =
        "Mengunduh MP4...";


      const blob =
        await response.blob();


      if (
        !blob ||
        blob.size <= 0
      ) {

        throw new Error(
          "File MP4 kosong"
        );

      }


      const objectUrl =
        URL.createObjectURL(
          blob
        );


      const filename =
        (
          `CAM${cameraNumber}_` +
          `${playbackDate.value}_` +
          `${playbackStart.value.replace(":", "")}-` +
          `${playbackEnd.value.replace(":", "")}.mp4`
        );


      const anchor =
        document.createElement(
          "a"
        );


      anchor.href =
        objectUrl;

      anchor.download =
        filename;

      anchor.style.display =
        "none";


      document.body.appendChild(
        anchor
      );


      anchor.click();

      anchor.remove();


      setTimeout(
        () => {

          URL.revokeObjectURL(
            objectUrl
          );

        },
        30000
      );


      playbackStatus.textContent =
        `Download siap · ${(blob.size / 1024 / 1024).toFixed(1)} MB`;

    }

    catch (error) {

      console.error(
        "[DOWNLOAD]",
        error
      );


      playbackStatus.textContent =
        error.message;

    }

    finally {

      downloadButton.disabled =
        false;

    }

  }


