  // ============================================================
  // FETCH TELEMETRY
  // ============================================================

  async function updateTelemetry() {

    if (
      destroyed
    ) {

      return;

    }


    try {

      const response =
        await fetch(
          `${telemetryEndpoint}&_=${Date.now()}`,
          {
            method:"GET",
            credentials:"include",
            cache:"no-store"
          }
        );


      if (
        !response.ok
      ) {

        throw new Error(
          `HTTP ${response.status}`
        );

      }


      const json =
        await response.json();


      if (
        !json ||
        json.success !== true ||
        !Array.isArray(
          json.data
        )
      ) {

        throw new Error(
          "Format telemetry tidak valid"
        );

      }


      // ========================================================
      // ARRAY -> OBJECT
      // ========================================================

      const telemetry = {};


      for (
        const item of json.data
      ) {

        if (
          !item ||
          !item.key
        ) {

          continue;

        }


        telemetry[
          String(
            item.key
          )
        ] =
          item.value;

      }


      console.log(
        "SENSOR TELEMETRY:",
        telemetry
      );


      processTelemetry(
        telemetry
      );


      // ========================================================
      // ONLINE
      // ========================================================

      connectionDot
        .classList
        .add(
          "online"
        );


      connectionText.textContent =
        "Live";

    } catch (
      error
    ) {

      console.error(
        "TELEMETRY ERROR:",
        error
      );


      connectionDot
        .classList
        .remove(
          "online"
        );


      connectionText.textContent =
        "Offline";

    }

  }


  // ============================================================
  // INITIAL
  // ============================================================

  updateTelemetry();


  // ============================================================
  // POLLING
  // ============================================================

  telemetryTimer =
    setInterval(
      updateTelemetry,
      POLLING_INTERVAL
    );


  // ============================================================
  // CLEANUP
  // ============================================================

  return () => {

    destroyed = true;


    if (
      telemetryTimer
    ) {

      clearInterval(
        telemetryTimer
      );

    }


    if (
      resizeObserver
    ) {

      resizeObserver.disconnect();

    }


    container.innerHTML = "";

  };

