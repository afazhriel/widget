function checkSensorStateChange(
  sensorKey,
  sensorName,
  currentState
) {

  // Pembacaan pertama hanya menjadi baseline.
  if (
    previousSensorStates[sensorKey] === undefined
  ) {

    previousSensorStates[sensorKey] =
      currentState;

    return;

  }


  const previousState =
    previousSensorStates[sensorKey];


  // Hanya kirim Telegram jika state benar-benar berubah.
  if (
    previousState !== currentState
  ) {

    previousSensorStates[sensorKey] =
      currentState;

   void sendTelegramNotification(
  sensorName,
  previousState,
  currentState
);

// Popup hanya muncul saat sensor berubah menjadi AKTIF
if (currentState === true) {
  showSensorNotification(
    sensorName,
    previousState,
    currentState
  );
}
    

    return;

  }


  previousSensorStates[sensorKey] =
    currentState;

}
