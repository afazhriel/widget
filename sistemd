  // ============================================================

  function normalizeState(
    value
  ) {

    if (
      value === true ||
      value === 1
    ) {

      return true;

    }


    if (
      value === false ||
      value === 0
    ) {

      return false;

    }


    const normalized =
      String(
        value ?? ""
      )
        .trim()
        .toUpperCase();


    return [

      "ON",
      "OPEN",
      "TRUE",
      "1",
      "ACTIVE",
      "DETECTED",
      "TRIGGERED",
      "MOTION",
      "ALARM"

    ].includes(
      normalized
    );

