  // ============================================================
  // BATTERY
  // ============================================================

  function normalizeBattery(
    value
  ) {

    if (
      value === null ||
      value === undefined ||
      value === ""
    ) {

      return null;

    }


    const battery =
      Number(
        String(value)
          .replace("%", "")
          .trim()
      );


    if (
      !Number.isFinite(
        battery
      )
    ) {

      return null;

    }


    return Math.max(
      0,
      Math.min(
        100,
        Math.round(
          battery
        )
      )
    );

  }


  // ============================================================
  // UPDATE SENSOR
  // ============================================================

  function updateSensor(
    sensor,
    state,
    battery,
    activeText,
    inactiveText,
    danger = false
  ) {

    const card =
      root.querySelector(
        `[data-card="${sensor}"]`
      );


    const stateElement =
      root.querySelector(
        `[data-state="${sensor}"]`
      );


    const batteryElement =
      root.querySelector(
        `[data-battery="${sensor}"]`
      );


    const batteryWrapper =
      root.querySelector(
        `[data-battery-wrapper="${sensor}"]`
      );


    if (
      !card ||
      !stateElement ||
      !batteryElement
    ) {

      return;

    }


    card.classList.remove(
      "active",
      "danger"
    );


    // ========================================================
    // STATE
    // ========================================================

    if (
      state
    ) {

      stateElement.textContent =
        activeText;


      if (
        danger
      ) {

        card.classList.add(
          "danger"
        );

      } else {

        card.classList.add(
          "active"
        );

      }

    } else {

      stateElement.textContent =
        inactiveText;

    }


    // ========================================================
    // BATTERY
    // ========================================================

    const batteryValue =
      normalizeBattery(
        battery
      );


    if (
      batteryValue === null
    ) {

      batteryElement.textContent =
        "--%";


      batteryWrapper
        ?.classList
        .remove(
          "low"
        );

    } else {

      batteryElement.textContent =
        `${batteryValue}%`;


      if (
        batteryValue <= 20
      ) {

        batteryWrapper
          ?.classList
          .add(
            "low"
          );

      } else {

        batteryWrapper
          ?.classList
          .remove(
            "low"
          );

      }

    }

  }

